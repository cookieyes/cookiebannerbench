{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.next",
      "!**/results",
      "!**/results-archive",
      "!**/node_modules",
      "!**/.vercel",
      "!site/out",
      "!**/*.tsbuildinfo",
      "!**/next-env.d.ts",
      "!demos",
      "!design-handoff",
      "!Claude outputs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/matched-c15t/tsconfig.json",
        "demos/cookieyes-react-ccpa/tsconfig.json",
        "packages/harness/axe-run.mjs"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["packages/harness/axe-run.mjs", "demos/cookieyes-react-ccpa/app/consent.tsx"],
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      }
    }
  ]
}
