{
  "name": "cookiebannerbench",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "bench": "pnpm --filter @cookiebannerbench/harness exec cookiebannerbench",
    "build:harness": "pnpm --filter @cookiebannerbench/harness build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run && pnpm --filter @cookiebannerbench/site test",
    "typecheck": "tsc -b packages/harness",
    "build": "pnpm --filter @cookiebannerbench/site build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
