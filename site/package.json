{
  "name": "@cookiebannerbench/site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "pnpm test && next build && node scripts/build-consent.mjs && node scripts/finalize-export.mjs && node scripts/markdown-export.mjs && CHECK_EXPORT=1 vitest run lib/__tests__/publication.test.ts",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "node serve.mjs",
    "audit:a11y": "node scripts/audit.mjs",
    "audit:perf": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@cookieyes/scripts": "0.4.0",
    "@cookieyes/vanilla": "0.1.1",
    "next": "15.5.26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.28.2",
    "node-html-markdown": "^2.0.0",
    "node-html-parser": "9.0.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
