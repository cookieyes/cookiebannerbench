{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": {
            "re": "text/markdown"
          }
        }
      ],
      "dest": "/index.md",
      "headers": {
        "content-type": "text/markdown; charset=utf-8",
        "vary": "Accept"
      }
    },
    {
      "src": "^/(.+?)/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": {
            "re": "text/markdown"
          }
        }
      ],
      "dest": "/$1/index.md",
      "headers": {
        "content-type": "text/markdown; charset=utf-8",
        "vary": "Accept"
      }
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</index.md>; rel=\"alternate\"; type=\"text/markdown\", </methodology/>; rel=\"help\", </sitemap.xml>; rel=\"describedby\"; type=\"application/xml\", <https://github.com/cookieyes/cookiebannerbench/blob/main/LICENSE>; rel=\"license\""
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/(.*)/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    }
  ]
}
